  m_Script: {fileID: 11500000, guid: e7a93f7b503a8114eb425fd6a5f0a6ec, type: 3}
  m_Name: Cain Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::CORK.Data.Dialogue.DialogueEntry
  lines:
  - speakerName: Dr. Cain
    text: "Oh! Come in, come in! Sorry \u2014 I was deep in a Path of Exile 2 build.
      I know I should be grading. I am grading. These are the same thing in my head
      right now."
  - speakerName: Dr. Cain
    text: "I also went 7-2 at Magic: the Gathering last Friday. Best night I've had
      in months. Anyway \u2014 you're not here to hear about that. What can I do
      for you?"
  - speakerName: Dr. Cain
    text: Grade appeal? Sure, let me pull it up right now.
  - speakerName: Dr. Cain
    text: "...Mmhm. Oh \u2014 oh this is great actually. Your answer on question
      three is more correct than the rubric. It's like a pumping lemma proof in reverse
      \u2014 the rubric is the language, and your solution is the string that breaks
      it. I love when that happens."
  - speakerName: Dr. Cain
    text: "Done! Adjusted. Should be in the portal within the hour. Is that smoke
      I smell? ...Probably just the break room microwave. Come back anytime \u2014
      my door is open."
