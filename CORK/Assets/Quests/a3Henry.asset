  m_Script: {fileID: 11500000, guid: e7a93f7b503a8114eb425fd6a5f0a6ec, type: 3}
  m_Name: a3Henry
  m_EditorClassIdentifier: Assembly-CSharp::CORK.Data.Dialogue.DialogueEntry
  lines:
  - speakerName: Henry
    text: ...Now THAT'S what I'm talking about.
  - speakerName: Henry
    text: "Okay. Thirty seconds. I'm logging into Canvas as admin... posting an announcement...
      \"All grades for Compilers have been improved by 5 points \u2014 check Canvas
      immediately.\""
  - speakerName: Henry
    text: Done. Watch those phones light up.
  - speakerName: You
    text: Is that legal?
  - speakerName: Henry
    text: It's definitely not. Thats why I didn't change your grade. No one will
      be able to link this back to me. Unfortunately, you will still have to go see
      Doctor Cain.
