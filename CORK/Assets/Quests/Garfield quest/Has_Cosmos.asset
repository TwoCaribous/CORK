  m_Script: {fileID: 11500000, guid: e7a93f7b503a8114eb425fd6a5f0a6ec, type: 3}
  m_Name: Has_Cosmos
  m_EditorClassIdentifier: Assembly-CSharp::CORK.Data.Dialogue.DialogueEntry
  lines:
  - speakerName: Professor Garfield
    text: YES. YES, that's it. That's the one. The garlic knots are dog-eared, that's
      how I know.
  - speakerName: Professor Garfield
    text: "I'm calling RIGHT NOW. Free pizza! I'll announce it in the hallway \u2014
      they'll hear me all the way to Cain's door. These students are going to LOVE
      me."
  - speakerName: You
    text: Please keep it together, Professor.
  - speakerName: Professor Garfield
    text: GARLIC KNOTS FOR EVERYONE!
